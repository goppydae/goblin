.nh
.TH "goblinctl" "1" "Jan 1970" "goblinctl 0.1.0-proto2g" "General Commands Manual"

.SH NAME
goblinctl - Goblin distributed supervisor control


.SH SYNOPSIS
\fBgoblinctl [flags]\fP


.SH DESCRIPTION
Goblin distributed supervisor control


.SH OPTIONS
\fB--control-addr\fP=""
	Address of the target daemon's control plane (empty: from config)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for goblinctl

.PP
\fB--log-level\fP=""
	Log level: debug, info, warn, error

.PP
\fB--tls-ca\fP=""
	CA certificate used to verify the daemon

.PP
\fB--tls-insecure\fP[=false]
	Skip verification (INSECURE)

.PP
\fB-v\fP, \fB--version\fP[=false]
	version for goblinctl


.SH SEE ALSO
\fBgoblinctl-agent(1)\fP, \fBgoblinctl-cluster(1)\fP, \fBgoblinctl-operator(1)\fP, \fBgoblinctl-tui(1)\fP, \fBgoblinctl-version(1)\fP
