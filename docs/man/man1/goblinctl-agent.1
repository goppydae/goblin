.nh
.TH "goblinctl" "1" "Jan 1970" "goblinctl 0.1.0-proto2g" "General Commands Manual"

.SH NAME
goblinctl-agent - Local agent management operations


.SH SYNOPSIS
\fBgoblinctl agent [flags]\fP


.SH DESCRIPTION
Local agent management operations


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for agent


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--control-addr\fP=""
	Address of the target daemon's control plane (empty: from config)

.PP
\fB--log-level\fP=""
	Log level: debug, info, warn, error

.PP
\fB--tls-ca\fP=""
	CA certificate used to verify the daemon

.PP
\fB--tls-insecure\fP[=false]
	Skip verification (INSECURE)

.PP
\fB-v\fP, \fB--version\fP[=false]
	version for goblinctl


.SH SEE ALSO
\fBgoblinctl(1)\fP, \fBgoblinctl-agent-build(1)\fP, \fBgoblinctl-agent-clean(1)\fP, \fBgoblinctl-agent-crypto(1)\fP, \fBgoblinctl-agent-lifecycle(1)\fP, \fBgoblinctl-agent-new(1)\fP, \fBgoblinctl-agent-ping(1)\fP, \fBgoblinctl-agent-reload(1)\fP, \fBgoblinctl-agent-shutdown(1)\fP, \fBgoblinctl-agent-status(1)\fP, \fBgoblinctl-agent-tui(1)\fP, \fBgoblinctl-agent-verify(1)\fP
