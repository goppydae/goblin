.nh
.TH "goblinctl" "1" "Jan 1970" "goblinctl 0.1.0-proto2g" "General Commands Manual"

.SH NAME
goblinctl-cluster - Cluster management operations


.SH SYNOPSIS
\fBgoblinctl cluster [flags]\fP


.SH DESCRIPTION
Cluster management operations


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for cluster


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--control-addr\fP=""
	Address of the target daemon's control plane (empty: from config)

.PP
\fB--log-level\fP=""
	Log level: debug, info, warn, error

.PP
\fB--tls-ca\fP=""
	CA certificate used to verify the daemon

.PP
\fB--tls-insecure\fP[=false]
	Skip verification (INSECURE)

.PP
\fB-v\fP, \fB--version\fP[=false]
	version for goblinctl


.SH SEE ALSO
\fBgoblinctl(1)\fP, \fBgoblinctl-cluster-agent(1)\fP, \fBgoblinctl-cluster-drain(1)\fP, \fBgoblinctl-cluster-migrate(1)\fP, \fBgoblinctl-cluster-migrate-instance(1)\fP, \fBgoblinctl-cluster-publish(1)\fP, \fBgoblinctl-cluster-run(1)\fP, \fBgoblinctl-cluster-status(1)\fP
