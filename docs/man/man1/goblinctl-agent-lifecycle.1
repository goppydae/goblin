.nh
.TH "goblinctl" "1" "Jan 1970" "goblinctl 0.1.0-proto2g" "General Commands Manual"

.SH NAME
goblinctl-agent-lifecycle - Control agent lifecycle


.SH SYNOPSIS
\fBgoblinctl agent lifecycle [flags]\fP


.SH DESCRIPTION
Control agent lifecycle


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for lifecycle


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--control-addr\fP=""
	Address of the target daemon's control plane (empty: from config)

.PP
\fB--log-level\fP=""
	Log level: debug, info, warn, error

.PP
\fB--tls-ca\fP=""
	CA certificate used to verify the daemon

.PP
\fB--tls-insecure\fP[=false]
	Skip verification (INSECURE)

.PP
\fB-v\fP, \fB--version\fP[=false]
	version for goblinctl


.SH SEE ALSO
\fBgoblinctl-agent(1)\fP, \fBgoblinctl-agent-lifecycle-reload(1)\fP, \fBgoblinctl-agent-lifecycle-restart(1)\fP, \fBgoblinctl-agent-lifecycle-start(1)\fP, \fBgoblinctl-agent-lifecycle-status(1)\fP, \fBgoblinctl-agent-lifecycle-stop(1)\fP
