# Agent ignore rules (gitignore-like globs).
# Purpose: constrain what agents read as context (and optionally where they write).
# Notes:
# - Patterns are repo-relative.
# - Negation supported via !pattern.

# Secrets and credentials
.env
**/*.pem
**/*.key
**/*.p12
**/.ssh/**
**/.gnupg/**
**/secrets/**

# Go build artifacts
**/vendor/**
**/*.so
**/*.a
**/*.o
**/bin/**
**/build/**

# Scenario build artifacts
scenarios/**/build_context/**
scenarios/**/*.tar

# Logs and runtime data
logs/**
**/*.log

# Databases / large binaries
**/*.sqlite
**/*.db
**/*.bin
**/*.zip

# Verification Runtime (supervision kernel) - agents MUST NOT modify
tools/cvr/**
requirements-verify.txt
.agent/workflows/**

# Allowlist the important stuff explicitly
!.agent/**
!docs/**
!AGENTS.md
!AGENDA.md
!implementation_plan.*
!walkthrough.md
!artifacts/**
