# --- OS / IDE Junk ---
.DS_Store
Thumbs.db
.idea/
.vscode/
.bin/
*.iml
*.ipr
*.iws
*~

# --- Go Binaries and Build Output ---
bin/
/goblinctl
/goblind
*.exe
*.dll
*.so
*.dylib
*.test
_go-build/

# --- Protobuf Generated Files (Internal) ---
# Note: Keep generated code in repo if specifically required for build consistency,
# but usually internal/proto/*.pb.go should be ignored if generated on-the-fly.
# We follow a "check-in generated code" policy for GAPI/Goblin currently,
# so we only ignore intermediate buf artifacts.
buf.lock
buf.gen.yaml.lock
.bufbuild/

# --- Python Cache and build artifacts ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
venv/
dist/

# --- Nix Build Outputs ---
result/

# --- Temporary / Runtime State ---
tmp/
test/tmp/
*.log
*.pid
*.sock
gapi.db
gapi.sock

# --- Databases (common local state) ---
*.db
*.sqlite

# --- Generated Documentation ---
docs/_build/
docs/build/
docs/generated/
site/
man/

# --- Mage Build Artifacts ---
mage_output/

# --- Air Live Reload ---
.air/

# --- Local Environment / Backups ---
config/*.local.*
config/*.backup.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
COMMIT_MESSAGE.md

# --- Coverage / Test Reports ---
cover.out
coverage.txt
coverage.xml
test-results.xml

# --- Scenario Build Contexts (Silo) ---
scenarios/goblin_cluster/build_context/

# --- Ephemeral CVRL Artifacts ---
# We preserve artifacts/history/ but ignore ephemeral run evidence
artifacts/logs/*
!artifacts/logs/agent_mode.json
!artifacts/agent_activity.jsonl
artifacts/test_results/
debug_cvrl_verify*.log
post_verify_report.md
