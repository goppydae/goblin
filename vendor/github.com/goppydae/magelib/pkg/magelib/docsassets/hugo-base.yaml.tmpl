# Generated by magelib DocsSync. Do not edit; edit the repo's DocsConfig.
#
# Hugo is invoked with this file FIRST and the repo's own docs/config.yaml
# second, so anything a repo needs to override it simply restates.

baseURL: {{ .BaseURL }}
# `locale`, not `languageCode`: the latter is deprecated as of Hugo
# v0.158.0 and warns on every build. Carried over from the reference
# implementation, which still spells it the old way.
locale: en-us
title: {{ .Title }}

taxonomies:
  category: categories
  tag: tags

module:
  imports:
    - path: github.com/McShelby/hugo-theme-relearn
  # Declaring ANY mount replaces Hugo's entire default mount set for that
  # target, so every directory a site uses has to be listed here even
  # though only two of them are magelib's. Omitting one does not error -
  # the content simply is not there, and a site that renders with a
  # section missing looks like a content problem.
  mounts:
    - source: content
      target: content
    - source: .magelib/layouts
      target: layouts
    - source: layouts
      target: layouts
    - source: .magelib/assets
      target: assets
    - source: assets
      target: assets
    - source: static
      target: static
    - source: data
      target: data

menu:
  taxonomylinks:
    - name: Categories
      url: /categories/
      weight: 1
    - name: Tags
      url: /tags/
      weight: 2

params:
  themeVariant:
    - auto:
        - zen-light
        - github-dark
  disableRootBreadcrumb: false
  disableTermBreadcrumbs: false
  disableNextPrev: false
  titleSeparator: "-"
  search:
    disable: false
  editURL: {{ .EditURL }}

  sidebarheadermenus:
    - type: divider
    - identifier: headercontrols
      type: custom
      elements:
        - type: homelink
        - type: githublink
          url: "https://{{ .Repo }}"
          label: GitHub
        - type: pkgsite
          repo: "{{ .Repo }}"
    - type: divider

  sidebarfootermenus:
    - type: divider
    - identifier: taxonomylinks
      type: menu
    - type: divider
    - identifier: footercontrols
      elements:
        - type: historyclearer
        - type: variantswitcher
        - type: languageswitcher
      type: custom

markup:
  goldmark:
    parser:
      attribute:
        block: true
    renderer:
      unsafe: true
  highlight:
    noClasses: false

# markdown, source and print alongside html publish each page's RAW
# MARKDOWN at a stable URL. That is what an agent reading the reference
# wants instead of scraped HTML, and it costs one block of configuration.
outputs:
  home:
    - html
    - rss
    - markdown
    - source
    - print
  page:
    - html
    - rss
    - markdown
    - source
    - print
  rss:
    - html
    - rss
    - markdown
    - source
    - print
  section:
    - html
    - rss
    - markdown
    - source
    - print
  taxonomy:
    - html
    - rss
    - print
  term:
    - html
    - rss
    - print
