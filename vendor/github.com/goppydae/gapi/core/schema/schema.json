{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "GAPI Agent Description Schema",
    "description": "Schema for the output of `agent --describe`",
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "description": "Unique identifier for the agent"
        },
        "type": {
            "type": "string",
            "enum": [
                "service",
                "timer",
                "socket",
                "pipe",
                "event",
                "init"
            ],
            "description": "Type of the agent"
        },
        "requires": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "description": "Hard dependencies (agent IDs)"
        },
        "wants": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "description": "Soft dependencies (agent IDs)"
        },
        "wanted_by": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "description": "Reverse soft dependencies"
        },
        "required_by": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "description": "Reverse hard dependencies"
        },
        "listen_stream": {
            "type": "string",
            "description": "Address to listen on (e.g. :8080) for socket activation"
        },
        "cpu_limit": {
            "type": "string",
            "description": "CPU limit (e.g. 0.5, 500m)"
        },
        "memory_limit": {
            "type": "string",
            "description": "Memory limit (e.g. 100MB, 1GB)"
        },
        "schedule": {
            "type": "string",
            "description": "Timer schedule (e.g. OnUnitActiveSec=5s, */5 * * * *)"
        },
        "capabilities": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Declarative capabilities provided by this agent"
        }
    },
    "required": [
        "id",
        "type"
    ]
}