// {{.Description}}
package agent

import (
	"context"
	"errors"
	"net"

	adk "github.com/goppydae/gapi/adk/go/agent"
)

const (
	ID          = "{{.ID}}"
	Type        = "socket"
	Version     = "1.0.0"
	Description = "{{.Description}}"
	Enabled     = true
)

// ListenStream declares the address THE SUPERVISOR binds, not one this
// agent binds. The supervisor creates and arms the listener before this
// process exists, so connections queue in the kernel's backlog while the
// agent starts, and the listener arrives here as an inherited descriptor.
var ListenStream = "127.0.0.1:8080"

// Start serves the inherited listener.
//
// Never call net.Listen on ListenStream. The supervisor has already bound
// it, so a fresh bind either fails with EADDRINUSE or races the
// supervisor and wins - which is worse, because the socket the supervisor
// is queueing connections on is then not the socket this agent is
// serving, and everything that arrived before startup is stranded.
func Start(ctx context.Context) error {
	ln, err := adk.Listener()
	if err != nil {
		return err
	}
	defer func() { _ = ln.Close() }()

	go func() {
		<-ctx.Done()
		_ = ln.Close()
	}()

	for {
		conn, err := ln.Accept()
		if err != nil {
			// A closed listener is the ordinary shutdown path, not a
			// failure: ctx cancellation closes it out from under Accept.
			if ctx.Err() != nil || errors.Is(err, net.ErrClosed) {
				return nil
			}
			return err
		}
		go handle(conn)
	}
}

func handle(conn net.Conn) {
	defer func() { _ = conn.Close() }()

	// TODO: Replace the echo with this agent's protocol
	buf := make([]byte, 4096)
	for {
		n, err := conn.Read(buf)
		if err != nil {
			return
		}
		if _, err := conn.Write(buf[:n]); err != nil {
			return
		}
	}
}
